# Copy this file to .env and edit the values. NEVER commit .env.
# Every value below is a placeholder. Choose your own password.

# --- Backend (read by backend/config.py) ---------------------------------------
# SQLAlchemy URL for PostgreSQL. If you use docker-compose, user, password and
# database name must match the POSTGRES_* values below.
DATABASE_URL=postgresql+psycopg://dataguard:change_me@localhost:5432/dataguard
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
UPLOAD_DIR=uploads

# --- docker-compose.yml (local PostgreSQL container) ----------------------------
POSTGRES_USER=dataguard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dataguard

# --- Tests (optional) -------------------------------------------------------------
# Export this in your SHELL before running pytest; it is not read from .env.
# The integration tests DROP and recreate the public schema of this database,
# so point it at a dedicated, empty test database, never your working one.
#   export TEST_DATABASE_URL=postgresql+psycopg://dataguard:change_me@localhost:5432/dataguard_test

# Streamlit dashboard: where the API is reachable (default shown)
DATAGUARD_API_URL=http://127.0.0.1:8000/api/v1
